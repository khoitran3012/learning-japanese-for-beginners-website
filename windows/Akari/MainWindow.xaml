<Window x:Class="Akari.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Akari — Học tiếng Nhật"
        Width="1280"
        Height="800"
        MinWidth="360"
        MinHeight="560"
        Background="{StaticResource Paper}"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <wv2:WebView2 x:Name="Browser" Visibility="Collapsed"/>
    <StackPanel x:Name="Gate" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Margin="28">
      <TextBlock Text="明" FontSize="54" HorizontalAlignment="Center" Foreground="{StaticResource Seal}"/>
      <TextBlock x:Name="TitleText" Text="Akari" FontSize="28" FontWeight="SemiBold"
                 HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource Ink}"/>
      <TextBlock x:Name="StatusText" Text="Đang mở bài học..." FontSize="15" TextWrapping="Wrap"
                 TextAlignment="Center" Margin="0,12,0,0" Foreground="{StaticResource Mute}"/>
      <Button x:Name="RetryButton" Content="Thử lại" Margin="0,18,0,0" Padding="18,8"
              HorizontalAlignment="Center" Visibility="Collapsed" Click="Retry_Click"/>
    </StackPanel>
  </Grid>
</Window>
